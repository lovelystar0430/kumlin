---
import Icon from './Icon.astro';
import { NAV_LINKS } from '../data/site';

interface Props {
  variant: 'overlay' | 'default';
}

const { variant } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => href === path;
---

<header class="site-header" data-variant={variant}>
  <div class="container site-header__bar">
    <a href="/" class="site-header__logo" aria-current={path === '/' ? 'page' : undefined}>
      <Icon name="logo" label="Kumlin – till startsidan" class="site-header__logo-svg" />
    </a>

    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Meny">
      <span class="site-header__toggle-line"></span>
      <span class="site-header__toggle-line"></span>
    </button>

    <div class="site-header__overlay">
      <nav id="site-nav" class="site-header__menu" aria-label="Huvudmeny">
        <ul role="list" class="site-header__list">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="site-header__link t-label" aria-current={isCurrent(link.href) ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="site-header__cta">
            <a href="/kontakt" class="btn btn--primary" aria-current={isCurrent('/kontakt') ? 'page' : undefined}>Ta kontakt</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<script>
  import '../scripts/nav';
</script>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1000;
    /* Slide-down on load (from the original Webflow embed) */
    transform: translateY(-100%);
    animation: header-slide-down 0.8s var(--ease-in-out-quad) 0.5s forwards;

    --header-fg: var(--color-heading);
    --logo-fg: var(--color-primary);
    --logo-fg-hover: var(--color-primary);
  }
  .site-header[data-variant='overlay'] {
    --header-fg: var(--color-bg);
    --logo-fg: var(--color-bg);
    --logo-fg-hover: var(--color-on-primary-muted);
  }

  @keyframes header-slide-down {
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      animation: none;
      transform: none;
    }
  }

  .site-header__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--pad-24);
  }

  .site-header__logo {
    display: block;
    width: 300px;
    height: 64px;
    color: var(--logo-fg);
    transition: color 0.3s;
  }
  .site-header__logo:hover {
    color: var(--logo-fg-hover);
  }
  .site-header__logo-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .site-header__list {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .site-header__link {
    display: inline-block;
    padding: 16px;
    color: var(--header-fg);
    text-decoration: none;
    vertical-align: top;
  }
  /* Underline grows on hover */
  .site-header__link::after {
    content: '';
    display: block;
    height: 1px;
    width: 0;
    background: currentColor;
    transition: width 300ms ease;
  }
  .site-header__link:hover::after {
    width: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__link::after {
      transition: none;
    }
  }

  .site-header__toggle {
    display: none;
  }

  /* ---------- Collapsed nav (≤ 991px) ---------- */
  @media (max-width: 991px) {
    .site-header__toggle {
      --thickness: 0.12rem;
      --gap: 0.6rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: var(--gap);
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      background: transparent;
      color: var(--header-fg);
      cursor: pointer;
    }
    .site-header__toggle-line {
      flex: none;
      width: 100%;
      height: var(--thickness);
      background-color: currentColor;
      transition: transform 0.2s ease;
    }
    .site-header__toggle[aria-expanded='true'] .site-header__toggle-line:first-child {
      transform: translateY(calc(var(--thickness) * 0.5 + var(--gap) * 0.5)) rotate(-45deg);
    }
    .site-header__toggle[aria-expanded='true'] .site-header__toggle-line:last-child {
      transform: translateY(calc(var(--thickness) * -0.5 + var(--gap) * -0.5)) rotate(45deg);
    }

    /* Clipping area below the bar that the menu slides down into */
    .site-header__overlay {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      height: 100vh;
      overflow: hidden;
      pointer-events: none;
      visibility: hidden;
      transition: visibility 0s linear 0.4s;
    }
    .site-header__menu {
      margin: 32px 32px 0;
      padding: 24px;
      border-radius: 24px;
      background-color: var(--color-border);
      text-align: center;
      pointer-events: auto;
      transform: translateY(calc(-100% - 32px));
      transition: transform 0.4s ease;
    }
    .site-header.is-open .site-header__overlay {
      visibility: visible;
      transition-delay: 0s;
    }
    .site-header.is-open .site-header__menu {
      transform: none;
    }

    .site-header__list {
      display: block;
    }
    .site-header__list > li {
      display: inline-flex;
      margin: 16px;
    }
    .site-header__link {
      display: inline-flex;
      flex-direction: column;
      /* Accessibility fix: the original used white links on this pale panel on the home page (~1.5:1 contrast). */
      color: var(--color-heading);
    }
  }

  @media (max-width: 991px) and (prefers-reduced-motion: reduce) {
    .site-header__menu,
    .site-header__overlay {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .site-header__logo {
      width: 240px;
    }
    .site-header__menu {
      margin: 24px 24px 0;
      padding: 16px;
    }
    .site-header__list > li {
      margin: 12px;
    }
  }

  @media (max-width: 479px) {
    .site-header__logo {
      width: 220px;
    }
    .site-header__menu {
      margin: 16px 16px 0;
    }
    .site-header__list > li {
      display: flex;
      justify-content: center;
    }
  }
</style>
